{
  "name": "oppskriftsboka",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first PWA som skanner oppskrifter fra kokebøker. Selve appen er avhengighetsfri – devDependencies brukes kun av testene.",
  "type": "module",
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "test:unit": "node --test 'test/{parser,columns,layout,quantity,recipe}.test.mjs'",
    "test:e2e": "playwright test",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "tesseract.js": "^5.1.1"
  }
}
